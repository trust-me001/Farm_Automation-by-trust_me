def safe_json_loads(text, default=None):
    """Безопасная загрузка JSON с обработкой ошибок"""
    try:
        return json.loads(text)
    except (json.JSONDecodeError, TypeError):
        return default

def safe_file_read(path, encoding='utf-8', default=''):
    """Безопасное чтение файла с обработкой ошибок"""
    try:
        with open(path, 'r', encoding=encoding) as f:
            return f.read()
    except Exception as e:
        logging.error(f"Error reading file {path}: {e}")
        return default

def safe_file_write(path, content, encoding='utf-8'):
    """Безопасная запись в файл с обработкой ошибок"""
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, 'w', encoding=encoding) as f:
            f.write(content)
        return True
    except Exception as e:
        logging.error(f"Error writing file {path}: {e}")
        return False

def load_cfg():
    """Загрузка конфигурации с обработкой ошибок"""
    if CFG_FILE.exists():
        try:
            content = safe_file_read(CFG_FILE)
            if content:
                return safe_json_loads(content, {})
        except Exception as e:
            logging.error(f'Error loading config: {e}')
    
    # Установка значений по умолчанию
    return {
        'use_txt': True,
        'txt_file': '',
        'ma_dir': '',
        'out_dir': '',
        'login': '',
        'password': '',
        'always_replace': False,
        'language': 'ru',
        'theme': 'dark',
        'generated_logins': {},
        'used_steamids': []
    }

def save_cfg(data):
    """Сохранение конфигурации с обработкой ошибок"""
    try:
        safe_file_write(CFG_FILE, json.dumps(data, ensure_ascii=False, indent=2))
    except Exception as e:
        logging.error(f'save_cfg: {e}')

def calculate_file_hash(file_path):
    """Calculate MD5 hash of a file with error handling"""
    hash_md5 = hashlib.md5()
    try:
        with open(file_path, "rb") as f:
            for chunk in iter(lambda: f.read(4096), b""):
                hash_md5.update(chunk)
        return hash_md5.hexdigest()
    except Exception as e:
        logging.error(f"Error calculating hash for {file_path}: {e}")
        return None

def load_ma_data(ma_path):
    """Загрузка данных из maFile с обработкой ошибок"""
    try:
        content = safe_file_read(ma_path)
        if not content:
            return None, None
            
        js = safe_json_loads(content)
        if not js:
            return None, None
            
        return js.get('Session', {}).get('SteamID'), js.get('account_name')
    except Exception as e:
        logging.error(f'Error loading maFile {ma_path}: {e}')
        return None, None

def get_used_steamids(out_dir, ma_dir):
    """Get SteamIDs that are currently in use by existing config files"""
    used_steamids = set()
    
    out_dir = Path(out_dir)
    ma_dir = Path(ma_dir)
    
    if not out_dir.exists() or not ma_dir.exists():
        return used_steamids
    
    # Check all config files in output directory
    for config_file in out_dir.glob('*.json'):
        try:
            login = config_file.stem
            ma_file = ma_dir / f'{login}.maFile'
            
            if ma_file.exists():
                steamid, _ = load_ma_data(ma_file)
                if steamid:
                    used_steamids.add(str(steamid))
        except Exception as e:
            logging.error(f"Error processing config file {config_file}: {e}")
    
    return used_steamids

def play_startup_sound():
    """Play a soft cross-platform startup sound"""
    try:
        # Используем resource_path для получения пути к звуковому файлу
        wav_path = resource_path('startup.wav')
        
        # Try to play external sound file if exists
        if os.path.exists(wav_path):
            try:
                import winsound
                winsound.PlaySound(wav_path, winsound.SND_FILENAME | winsound.SND_ASYNC)
                return
            except:
                pass
                
            try:
                from playsound import playsound
                playsound(wav_path, block=False)
                return
            except:
                pass
        
        # Generate a simple beep as fallback
        try:
            import winsound
            winsound.Beep(800, 200)
            time.sleep(0.1)
            winsound.Beep(1000, 300)
        except:
            # Cross-platform beep for other OS
            print('\a')
            time.sleep(0.2)
            print('\a')
    except Exception:
        pass

def sanitize_filename(name):
    """Очистка имени файла от недопустимых символов"""
    return re.sub(r'[\\/*?:"<>|]', "_", name)

