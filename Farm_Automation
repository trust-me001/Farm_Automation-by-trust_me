    def refresh_accounts(self):
        """Refresh the list of accounts - только созданные программой"""
        # Clear existing items
        for item in self.tree.get_children():
            self.tree.delete(item)
        
        # Get config directory
        config_dir = Path(self.out_dir.get())
        if not config_dir.exists():
            return
        
        # Get list of accounts created by this program
        generated_logins = self.cfg.get('generated_logins', {})
        
        # Scan for config files
        for config_file in config_dir.glob('*.json'):
            try:
                account_name = config_file.stem
                
                # Пропускаем аккаунты, не созданные этой программой
                if account_name not in generated_logins:
                    continue
                    
                ma_file = MA_DIR / f'{account_name}.maFile'
                
                # Determine status
                if not ma_file.exists():
                    status = self.lang['account_not_found']
                    status_color = 'error'
                else:
                    # Try to read config to check if it's valid
                    try:
                        with open(config_file, 'r', encoding='utf-8') as f:
                            config_data = json.load(f)
                        status = self.lang['account_valid']
                        status_color = 'ok'
                    except:
                        status = self.lang['account_invalid']
                        status_color = 'error'
                
                # Add to treeview with alternating row colors
                item_id = self.tree.insert('', 'end', values=(
                    account_name, 
                    status,
                    self.lang['delete_account']
                ))
                
                # Apply alternating row colors
                if len(self.tree.get_children()) % 2 == 0:
                    self.tree.set(item_id, column='#0', value='even')
                else:
                    self.tree.set(item_id, column='#0', value='odd')
                
                # Color code based on status
                if status_color == 'error':
                    self.tree.set(item_id, 'status', status)
                
            except Exception as e:
                logging.error(f"Error processing account {config_file}: {e}")

    def on_account_double_click(self, event):
        """Handle double click on account row"""
        try:
            item = self.tree.selection()[0]
            account_name = self.tree.item(item, 'values')[0]
            column = self.tree.identify_column(event.x)
            
            if column == '#1':  # Account name column - open config
                self.open_config_file(account_name)
            elif column == '#2':  # Status column - open maFile
                self.open_mafile(account_name)
            elif column == '#3':  # Actions column - delete account
                self.delete_account(account_name)
        except IndexError:
            # No item selected
            pass

    def open_config_file(self, account_name):
        """Open config file in default editor"""
        try:
            config_file = Path(self.out_dir.get()) / f'{account_name}.json'
            if config_file.exists():
                if sys.platform == 'win32':
                    os.startfile(str(config_file))
                elif sys.platform == 'darwin':  # macOS
                    os.system(f'open "{config_file}"')
                else:  # Linux
                    os.system(f'xdg-open "{config_file}"')
        except Exception as e:
            self.log_message(f"Error opening config: {e}")

