    def apply_theme(self):
        """Apply the current theme to all widgets"""
        self.theme = THEMES[self.current_theme]
        self.configure(bg=self.theme['bg'])
        
        # Reconfigure styles
        self._setup_styles()
        
        # Apply theme to all child widgets
        for widget in self.winfo_children():
            self._apply_theme_to_widget(widget)
            
        # Update status label
        self.status_lbl.config(bg=self.theme['status_ok'], fg=self.theme['fg'])
        
        # Update log text
        self.log_text.config(bg=self.theme['text_bg'], fg=self.theme['text_fg'])
        
        # Refresh account list to apply theme
        self.refresh_accounts()
    
    def _apply_theme_to_widget(self, widget):
        """Recursively apply theme to a widget and its children"""
        widget_type = widget.winfo_class()
        
        try:
            if widget_type == 'Text' or widget_type == 'ScrolledText':
                widget.config(bg=self.theme['text_bg'], fg=self.theme['text_fg'])
            elif widget_type == 'Listbox':
                widget.config(bg=self.theme['entry_bg'], fg=self.theme['entry_fg'])
            elif widget_type == 'Label':
                widget.config(bg=self.theme['frame_bg'], fg=self.theme['fg'])
            elif widget_type == 'Button':
                widget.config(bg=self.theme['button_bg'], fg=self.theme['button_fg'],
                            activebackground=self.theme['button_active_bg'],
                            activeforeground=self.theme['button_fg'])
        except Exception as e:
            logging.error(f"Error applying theme to widget: {e}")
        
        # Apply to children
        for child in widget.winfo_children():
            self._apply_theme_to_widget(child)

    def process_queue(self):
        try:
            while True:
                func = self.gui_queue.get_nowait()
                func()
        except q.Empty:
            pass
        finally:
