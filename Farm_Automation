    def delete_account(self, account_name):
        """Delete an account (config and maFile)"""
        # Confirm deletion
        if not messagebox.askyesno(
            self.lang['delete_confirm'],
            self.lang['delete_confirm_msg'].format(account_name)
        ):
            return
        
        # Delete config file
        config_file = Path(self.out_dir.get()) / f'{account_name}.json'
        if config_file.exists():
            try:
                config_file.unlink()
            except Exception as e:
                self.log_message(f"Error deleting config: {e}")
        
        # Delete maFile
        ma_file = MA_DIR / f'{account_name}.maFile'
        if ma_file.exists():
            try:
                ma_file.unlink()
            except Exception as e:
                self.log_message(f"Error deleting maFile: {e}")
        
        # Remove from generated_logins and used_steamids
        if account_name in self.cfg.get('generated_logins', {}):
            # Get steamid before removing
            steamid = self.cfg['generated_logins'][account_name].get('steamid')
            # Remove from generated_logins
            del self.cfg['generated_logins'][account_name]
            # Remove from used_steamids if present
            if steamid and steamid in self.cfg.get('used_steamids', []):
                self.cfg['used_steamids'].remove(steamid)
            
            # Save updated config
            save_cfg(self.cfg)
        
        # Refresh account list
        self.refresh_accounts()
        
        # Log action
        self.log_message(self.lang['account_deleted'].format(account_name))

    def log_message(self, message):
        """Add a message to the log panel"""
        timestamp = datetime.now().strftime("%H:%M:%S")
        # Экранируем специальные символы для безопасного логирования
        safe_message = str(message).replace('%', '%%')
        formatted_message = f"[{timestamp}] {safe_message}\n"
        
        self.gui_queue.put(lambda: self._add_log_message(formatted_message))
        logging.info(safe_message)

    def _add_log_message(self, message):
        """Thread-safe method to add message to log"""
        self.log_text.config(state=tk.NORMAL)
        self.log_text.insert(tk.END, message)
        self.log_text.see(tk.END)
        self.log_text.config(state=tk.DISABLED)

