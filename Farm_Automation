    def start_generation(self):
        if getattr(self, '_running', False):
            self.log_message(self.lang['process_running'])
            return
            
        self._running = True
        self.log_message(self.lang['processing_start'])
        threading.Thread(target=self.run_generation, daemon=True).start()

    def run_generation(self):
        # Show progress bar
        self.gui_queue.put(lambda: self.progress.pack(fill=tk.X, padx=10, pady=2))
        self.gui_queue.put(lambda: self.status_lbl.config(
            text=self.lang['status_processing'], bg=self.theme['status_warning']))
        self.gui_queue.put(lambda: self.progress.configure(value=0))

        # Validate paths
        ma_in = Path(self.ma_dir.get())
        out_dir = Path(self.out_dir.get())
        
        if not ma_in.is_dir():
            self.log_message(self.lang['no_mafile_folder'])
            self.gui_queue.put(lambda: self.status_lbl.config(
                text=self.lang['status_error'], bg=self.theme['status_error']))
            self.gui_queue.put(lambda: self.progress.pack_forget())
            self._running = False
            return
            
        if not out_dir.is_dir():
            self.log_message(self.lang['no_asf_folder'])
            self.gui_queue.put(lambda: self.status_lbl.config(
                text=self.lang['status_error'], bg=self.theme['status_error']))
            self.gui_queue.put(lambda: self.progress.pack_forget())
            self._running = False
            return

        # Get currently used SteamIDs from existing files
        used_steamids = get_used_steamids(out_dir, MA_DIR)
        self.log_message(f"Found used SteamIDs: {len(used_steamids)}")

        # Load accounts
        accounts = []
        bad_lines = 0
        
        if self.use_txt.get():
            txt = Path(self.txt_file.get())
            if not txt.is_file():
                self.log_message(self.lang['no_accounts_file'])
                self.gui_queue.put(lambda: self.status_lbl.config(
                    text=self.lang['status_error'], bg=self.theme['status_error']))
                self.gui_queue.put(lambda: self.progress.pack_forget())
                self._running = False
                return
                
            self.log_message(self.lang['reading_accounts'].format(txt))
            try:
                content = safe_file_read(txt)
                for i, ln in enumerate(content.splitlines(), 1):
                    try:
                        ln = ln.strip()
                        if not ln or ln.startswith('#'):  # Skip empty lines and comments
                            continue
                            
                        if ':' not in ln:
                            self.log_message(self.lang['invalid_line'].format(i, ln))
                            bad_lines += 1
                            continue
                            
                        parts = ln.split(':', 1)  # Split only on first colon
                        login, pwd = parts[0].strip(), parts[1].strip()
                        
                        if not login or not pwd:
                            self.log_message(self.lang['invalid_line'].format(i, ln))
                            bad_lines += 1
                            continue
                            
                        # Check for special characters in password
                        if any(c in pwd for c in '%\\'):
                            self.log_message(self.lang['special_chars_warning'])
                            
                        accounts.append((login, pwd))
                        self.log_message(f"Found account: {login}")
                    except Exception as e:
                        self.log_message(f"Error processing line {i}: {e}")
                        bad_lines += 1
            except Exception as e:
                self.log_message(f"Error reading accounts file: {e}")
                self.gui_queue.put(lambda: self.status_lbl.config(
                    text=self.lang['status_error'], bg=self.theme['status_error']))
                self.gui_queue.put(lambda: self.progress.pack_forget())
                self._running = False
                return
                
            if bad_lines:
                self.log_message(self.lang['invalid_lines'].format(bad_lines))
        else:
            login = self.login.get().strip()
            pwd = self.password.get().strip()
            
            if not login or not pwd:
                self.log_message(self.lang['no_login_password'])
                self.gui_queue.put(lambda: self.status_lbl.config(
                    text=self.lang['status_error'], bg=self.theme['status_error']))
                self.gui_queue.put(lambda: self.progress.pack_forget())
                self._running = False
                return
                
            # Check for special characters in password
            if any(c in pwd for c in '%\\'):
                self.log_message(self.lang['special_chars_warning'])
                
            accounts = [(login, pwd)]
            self.log_message(self.lang['using_manual'])

        if not accounts:
            self.log_message(self.lang['no_accounts'])
            self.gui_queue.put(lambda: self.status_lbl.config(
                text=self.lang['status_error'], bg=self.theme['status_error']))
            self.gui_queue.put(lambda: self.progress.pack_forget())
            self._running = False
            return
            
        self.log_message(self.lang['found_accounts'].format(len(accounts)))

        # Find matching maFiles
        pairs = []
        
        self.log_message(self.lang['searching_mafiles'])
        
        for mafile in sorted(ma_in.glob('*.maFile')):
            sid, ma_login = load_ma_data(mafile)
            if sid is None or ma_login is None:
                self.log_message(self.lang['mafile_read_error'].format(mafile.name))
                continue
                
            for login, pwd in accounts:
                if ma_login == login:
                    if str(sid) in used_steamids:
                        self.log_message(self.lang['steamid_used'].format(sid, login))
                        # Check if we should replace existing files
                        cfg_path = out_dir / f'{login}.json'
                        ma_path = MA_DIR / f'{login}.maFile'
                        
                        if cfg_path.exists() and ma_path.exists():
                            # Files exist, check if we should replace them
                            need_replace = self.always_replace.get()
                            
                            if not need_replace:
                                # Use queue to show dialog in main thread
                                result = []
                                self.gui_queue.put(lambda: result.append(
                                    messagebox.askyesno(
                                        self.lang['replace_title'],
                                        self.lang['replace_msg'].format(login)
                                    )
                                ))
                                
                                # Wait for response
                                while not result:
                                    time.sleep(0.1)
                                    
                                need_replace = result[0]
                            
                            if need_replace:
                                pairs.append((mafile, login, pwd, sid))
                            else:
                                self.log_message(self.lang['skipping_existing'].format(login))
                        else:
                            # Files don't exist, but SteamID is in use by another login
                            self.log_message(f"SteamID {sid} используется другим аккаунтом, пропускаем: {login}")
                    else:
                        # SteamID is not in use, add to pairs
                        pairs.append((mafile, login, pwd, sid))
                    break

        if not pairs:
            self.log_message(self.lang['no_matches'])
            self.gui_queue.put(lambda: self.status_lbl.config(
                text=self.lang['status_error'], bg=self.theme['status_error']))
            self.gui_queue.put(lambda: self.progress.pack_forget())
            self._running = False
            return
            
        self.log_message(self.lang['found_matches'].format(len(pairs)))

        # Process each pair
        done = 0
        created = 0
        skipped = 0
        replaced = 0
        errors = 0
        
        for mafile, login, pwd, sid in pairs:
            self.log_message(self.lang['processing_account'].format(login))
            
            # Sanitize login for filename
            safe_login = sanitize_filename(login)
            cfg_path = out_dir / f'{safe_login}.json'
            ma_path = MA_DIR / f'{safe_login}.maFile'
            
            # Calculate hash of source maFile
            source_hash = calculate_file_hash(mafile)
            if source_hash is None:
                self.log_message(f"Ошибка чтения maFile: {mafile.name}")
                errors += 1
                continue
                
            # Check if config already exists
            config_exists = cfg_path.exists()
            ma_exists = ma_path.exists()
            
            # Check if we need to replace
            need_replace = False
            if config_exists and ma_exists:
                # Check if maFile has changed
                existing_hash = calculate_file_hash(ma_path)
                if existing_hash != source_hash:
                    self.log_message(self.lang['mafile_changed'].format(login))
                    need_replace = True
                
                # Check if config has different password
                try:
                    existing_cfg_content = safe_file_read(cfg_path)
                    existing_cfg = safe_json_loads(existing_cfg_content, {})
                    if existing_cfg.get('SteamPassword') != pwd:
                        self.log_message(self.lang['password_changed'].format(login))
                        need_replace = True
                except:
                    self.log_message(self.lang['config_read_error'].format(login))
                    need_replace = True
                    
            # Ask for replacement if needed (unless always_replace is set)
            if config_exists and not self.always_replace.get() and need_replace:
                # Use queue to show dialog in main thread
                result = []
                self.gui_queue.put(lambda: result.append(
                    messagebox.askyesno(
                        self.lang['replace_title'],
                        self.lang['replace_msg'].format(login)
                    )
                ))
                
                # Wait for response
                while not result:
                    time.sleep(0.1)
                    
                need_replace = result[0]
            
            # Process based on conditions
            if config_exists and not need_replace:
                self.log_message(self.lang['skipping_existing'].format(login))
                skipped += 1
            else:
                # Create or update config
                cfg = {
                    'Enabled': True,
                    'SteamLogin': login,
                    'SteamPassword': pwd,
                    'GamesPlayedWhileIdle': [440, 570, 730]
                }
                
                try:
                    # Write config file
                    cfg_json = json.dumps(cfg, indent=2, ensure_ascii=False)
                    if not safe_file_write(cfg_path, cfg_json):
                        raise Exception("Failed to write config file")
                    
                    # Copy maFile
                    with open(mafile, 'rb') as src, open(ma_path, 'wb') as dst:
                        dst.write(src.read())
                    
                    # Update tracking
                    if login not in self.cfg.get('generated_logins', {}):
                        # Add to used_steamids if it's a new account
                        if sid and str(sid) not in self.cfg.get('used_steamids', []):
                            self.cfg.setdefault('used_steamids', []).append(str(sid))
                    
                    # Update generated_logins
                    self.cfg.setdefault('generated_logins', {})[login] = {
                        'steamid': str(sid) if sid else None,
                        'mafile_hash': source_hash,
                        'updated': datetime.now().isoformat()
                    }
                    
                    if config_exists:
                        self.log_message(self.lang['updated'].format(login))
                        replaced += 1
                    else:
                        self.log_message(self.lang['created'].format(login))
                        created += 1
                        
                except Exception as e:
                    self.log_message(self.lang['config_error'].format(login, e))
                    errors += 1
            
            # Update progress
            done += 1
            progress = int(done / len(pairs) * 100)
            self.gui_queue.put(lambda v=progress: self.progress.configure(value=v))

        # Save configuration
        save_cfg(self.cfg)

        # Show results
        self.gui_queue.put(lambda: self.progress.pack_forget())
        
        final_msg = self.lang['completed_msg'].format(created, replaced, skipped, errors)
        self.log_message(final_msg)
        
        self.gui_queue.put(lambda: messagebox.showinfo(
            self.lang['completed_title'], final_msg))
        self.gui_queue.put(lambda: self.status_lbl.config(
            text=self.lang['status_success'], bg=self.theme['status_ok']))
        
        # Refresh account list
        self.refresh_accounts()
        
        self._running = False

if __name__ == '__main__':
    app = App()
    app.mainloop()

